@echo off
chcp 65001 >nul
title GitHub Auto-Uploader - TGBot

echo ===================================================
echo           سامانه آپلود خودکار پروژه در گیتهاب
echo ===================================================
echo.

echo [1/3] بررسی وضعیت و تغییرات جدید...
git status -s

echo.
set /p commit_msg="پیام کامیت (Enter برای پیام خودکار تاریخ و ساعت): "

if "%commit_msg%"=="" (
    set commit_msg=بروزرسانی خودکار پروژه در تاریخ %date% ساعت %time%
)

echo.
echo [2/3] آماده‌سازی و ثبت تغییرات (Commit)...
git add .
git commit -m "%commit_msg%"

echo.
echo [3/3] در حال ارسال و آپلود در گیتهاب (Push)...
git push origin main

if %errorlevel% equ 0 (
    echo.
    echo ===================================================
    echo   [موفقیت] تمام تغییرات با موفقیت در گیتهاب آپلود شد!
    echo ===================================================
) else (
    echo.
    echo ===================================================
    echo   [راهنما] اگر پنجره مرورگر باز شد، لاگین اکانت گیتهاب را تایید کنید.
    echo ===================================================
)

echo.
pause
