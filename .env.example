# ==============================================================================
# 🚀 HiddiBot & Multi-Bot Management Platform - Environment Variables
# ==============================================================================
# این فایل نمونه‌ای از متغیرهای پیکربندی سرور و پروژه است.
# برای اعمال دستی، می‌توانید آن را به نام .env ذخیره نمایید.

# ------------------------------------------------------------------------------
# 🌐 ۱. تنظیمات شبکه و پورت سرور وب (پیشگیری از تداخل با هیدیفای، لایسنس‌هاب و سایر پروژه‌ها)
# ------------------------------------------------------------------------------
# پورت اجرای وب‌پنل مدیریت و پورتال‌های کاربران (پیش‌فرض: 5000)
# در صورت هم‌زیستی با هیدیفای یا پروژه‌های دیگر، پورت آزاد دلخواه (مثلاً 5001 یا 8085) تنظیم کنید.
PORT=5000
PANEL_PORT=5000

# آدرس شنود شبکه (0.0.0.0 برای دسترسی مستقیم، 127.0.0.1 برای امنیت پشت Nginx/هیدیفای)
HOST=0.0.0.0
PANEL_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 🔒 ۲. امنیت، سشن و مسیر پایدار ذخیره‌سازی داده‌ها
# ------------------------------------------------------------------------------
# مسیر ذخیره‌سازی پایدار دیتابیس SQLite و فایل‌ها (مناسب داکر و ریلوی)
DATA_DIR=data

# کلید تصادفی امن جهت رمزنگاری نشست‌های مدیریت و کوکی‌های Flask
DASHBOARD_SECRET=change_this_to_a_secure_random_string_32_chars

# کلید لایسنس فعال‌سازی محصول
LICENSE_KEY=

# ------------------------------------------------------------------------------
# 🤖 ۳. ربات تلگرام و شناسه مدیر ارشد
# ------------------------------------------------------------------------------
# توکن ربات اصلی دریافت شده از BotFather
BOT_TOKEN=

# شناسه عددی تلگرام مدیر ارشد جهت دریافت اعلان‌ها و دسترسی به دستورات ادمین
ADMIN_ID=

# ------------------------------------------------------------------------------
# 🔗 ۴. دامنه و اتصال به وب‌سرویس هیدیفای (Hiddify Panel API)
# ------------------------------------------------------------------------------
# دامنه اختصاصی متصل به پنل و پورتال مشتریان (بدون https://)
CUSTOM_DOMAIN=

# آدرس کامل پنل هیدیفای
HIDIFY_PANEL_URL=

# کلید احراز هویت وب‌سرویس هیدیفای
HIDIFY_API_KEY=

# مسیر پروکسی ادمین هیدیفای (Admin Proxy Path)
HIDIFY_PROXY_PATH=

# مسیر پروکسی مشترکین هیدیفای (پیش‌فرض: user)
USER_PROXY_PATH=user
