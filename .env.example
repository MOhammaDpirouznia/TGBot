# ═══════════════════════════════════════════════════════════════════════
# 🤖 تنظیمات اصلی ربات تلگرام (Telegram Bot Credentials)
# ═══════════════════════════════════════════════════════════════════════

# توکن ربات تلگرام دریافت شده از BotFather@
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# شناسه عددی اکانت تلگرام مدیر اصلی (جهت دریافت اعلان‌ها و دسترسی سوپرادمین)
ADMIN_ID=123456789


# ═══════════════════════════════════════════════════════════════════════
# 🛡️ تنظیمات ارتباط با سرور هیدیفای (Hiddify Manager API)
# ═══════════════════════════════════════════════════════════════════════

# آدرس کامل پنل ادمین هیدیفای همراه با اسلش انتهایی
HIDIFY_PANEL_URL=https://panel.example.com/your_secret_admin_path/

# کلید API پنل هیدیفای (از منوی ادمین‌ها در هیدیفای قابل کپی است)
HIDIFY_API_KEY=your_hiddify_admin_api_uuid_key


# ═══════════════════════════════════════════════════════════════════════
# 🌐 تنظیمات داشبورد وب و پنل مدیریت (Web Dashboard & RBAC)
# ═══════════════════════════════════════════════════════════════════════

# کلید رمزنگاری سشن‌های فلسک (یک رشته تصادفی و امن طولانی)
SECRET_KEY=change_this_to_a_very_long_secure_random_string_xyz123

# نام کاربری و رمز عبور ورود اولیه به پنل مدیریت وب
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_super_password_2026

# پورت اجرای وب‌سرور (پیش‌فرض: 5000)
PORT=5000

# حالت دیباگ (در سرور پروداکشن False باشد)
DEBUG=False
